# Message Broker
# AMQP port, e.g. amqp://user:pass@localhost:5673 (not the management UI port)
MESSAGE_BROKER_URL=
# Defaults to <NODE_ENV>_send_email_queue, the same name the API publishes to
EMAIL_QUEUE_NAME=
# Emails sent at the same time (default 5)
EMAIL_CONCURRENCY=

# Email
EMAIL_SERVICE=
EMAIL_HOST=
EMAIL_PORT=
EMAIL_USERNAME=
EMAIL_PASSWORD=
# true for port 465 (SSL)
EMAIL_SECURE=
# Sender, e.g. "ZApp" <no-reply@yourdomain.com>
EMAIL_FROM=

# Database
DATABASE_HOST=
DATABASE_PORT=
DATABASE_NAME=
DATABASE_USERNAME=
DATABASE_PASSWORD=
DATABASE_DRIVER=